[
  {
    "rule_id": "GB50015-2019-5.2.1",
    "standard": "GB 50015",
    "standard_year": 2019,
    "clause": "5.2.1",
    "category": "building_rain",
    "scope": "steel_factory_gravity_rainwater",
    "content_type": "clause",
    "rule_type": "formula",
    "statement": "建筑屋面设计雨水流量应按下式计算：qy=qj·ψ·Fw/10000。当坡度大于2.5%的斜屋面或采用内檐沟集水时，设计雨水流量应乘以系数1.5。式中：qy—设计雨水流量(L/s)；qj—设计暴雨强度[L/(s·hm2)]；ψ—径流系数；Fw—汇水面积(m2)。",
    "formula": {
      "expression": "qy = qj * psi * Fw / 10000 * (slope > 0.025 || inner_eaves_gutter ? 1.5 : 1.0)",
      "variables": {
        "qy": "设计雨水流量 (L/s)",
        "psi": "径流系数，屋面可取 1.00（GB 50015-2019 5.2.6）",
        "qj": "设计暴雨强度 [L/(s·hm2)]，按当地暴雨强度公式计算（5.2.2）",
        "Fw": "汇水面积 (m2)，按水平投影面积计算，侧墙附加 1/2（5.2.7）",
        "slope": "屋面坡度",
        "inner_eaves_gutter": "是否采用内檐沟集水"
      },
      "external_params": [
        "当地暴雨强度公式 A1/C/b/n（5.2.2）",
        "设计重现期 P（5.2.4）"
      ]
    },
    "subject": "roof_design_rain_flow",
    "mandatory_level": "recommended",
    "mandatory_level_pending": {
      "_TEMPORARY": true,
      "intended_level": "clause",
